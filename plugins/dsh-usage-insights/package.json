{
  "name": "@local/dsh-usage-insights",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Token usage dashboard for DeepSeek Harness: DeepSeek API cost, GLM Coding Plan credits, cache hit/miss, peak/off-peak, and provider/key breakdowns.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
